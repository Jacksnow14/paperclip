[Unit]
Description=X Repost Worker (AUR-2388)
After=network.target paperclip.service
Wants=paperclip.service

[Service]
Type=simple
User=ievgen
WorkingDirectory=/home/ievgen/paperclip
EnvironmentFile=/home/ievgen/paperclip-data/x-repost-worker.env
ExecStart=/usr/bin/node /home/ievgen/paperclip/scripts/x-repost-worker.mjs
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
