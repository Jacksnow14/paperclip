# AUR-4028: auto-deploy tick — arms origin/master into an activated release;
# when PAPERCLIP_AUTO_RESTART_ENABLED=1 (AUR-4032, NOT this landing) it also
# restarts paperclip.service into it at quiescence, with auto-rollback.
#
# This is DELIBERATELY a `systemd --user` unit, unlike AUR-3937's system-level
# drift timer: this unit restarts paperclip.service, which is itself a --user
# unit. The process doing the restart must not be a child of paperclip.service
# (that is the "the restart kills the run doing the restart" trap) — a --user
# sibling survives the restart AND has native `systemctl --user` access with no
# XDG_RUNTIME_DIR/DBus plumbing, which a system-level unit would need to reach
# the user manager. Installed by scripts/deploy/install-auto-deploy-timer.sh.
#
# ExecStart points at the ACTIVE RELEASE (same convention as the drift timer):
# the deploy logic itself ships pinned and reviewed inside releases.
[Unit]
Description=Paperclip auto-deploy tick (arm origin/master + optional quiescent restart)
Documentation=https://paperclip/AUR/issues/AUR-4028

[Service]
Type=oneshot
ExecStart=/opt/paperclip/app/current/scripts/deploy/auto-deploy.sh
# Stage 2 lands DARK. AUR-4032 arms it with an explicit drop-in
# (systemctl --user edit paperclip-auto-deploy.service) — not by editing this
# committed file.
Environment=PAPERCLIP_AUTO_RESTART_ENABLED=0
# AUR-4034: build from the root-owned bare mirror, not the shared, mutable
# /home/ievgen/paperclip checkout. The mirror is refreshed independently
# (paperclip-src-mirror-refresh.timer) and is not writable by this unit's
# user, so build-release.sh/safe-deploy.sh skip fetching into it directly.
Environment=PAPERCLIP_DEPLOY_SRC_REPO=/opt/paperclip/src.git
# A tick can legitimately hold the lock for a full release build plus a
# quiescence-gated restart; do not let systemd kill it mid-build.
# AUR-5019: the migration gate adds up to PAPERCLIP_MIGRATION_GATE_TIMEOUT_SEC
# (default 2400 s = 40 min) between build and flip. This value must stay ABOVE
# worst-case build (~15 min, safe-deploy watchdogged) + gate cap (40 min) +
# slack; the gate handles SIGTERM by cleaning up its scratch dir, but a unit
# timeout mid-replay is still a wasted tick. 45min < 15+40 collided; 75min
# does not.
TimeoutStartSec=75min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=paperclip-auto-deploy
