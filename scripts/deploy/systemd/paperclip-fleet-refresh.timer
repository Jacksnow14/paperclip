# Daily at 06:30 UTC — after the overnight quiet period, before the working
# burst. Persistent=true so a reboot that skips the window still refreshes.
[Unit]
Description=Run the Paperclip fleet model refresh daily at 06:30 UTC

[Timer]
OnCalendar=*-*-* 06:30:00 UTC
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
